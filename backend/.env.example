# PostgreSQL (recommended). Leave blank to use local SQLite.
# DATABASE_URL=postgresql+psycopg://focusstack:focusstack@localhost:5432/focusstack

POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=focusstack
POSTGRES_USER=focusstack
POSTGRES_PASSWORD=focusstack

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Accounts & sign-in ----------------------------------------------------
# Public address of the site. Used for OAuth redirect URIs and post-login redirects.
#   local dev:  http://localhost:5173      production: https://www.focusstack.tech
APP_URL=http://localhost:5173
SESSION_DAYS=30

# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, "Web application")
#   Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: comma-separated emails allowed to sign up / sign in. Empty = anyone can sign up.
SIGNUP_ALLOWLIST=
